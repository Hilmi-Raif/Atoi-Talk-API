APP_ENV=development
APP_PORT=8080
RATE_LIMIT_ENABLED=true
CAPTCHA_ENABLED=false

DB_HOST=postgres
DB_PORT=5434
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=atoitalk_dev
DB_SSLMODE=disable
DB_MIGRATE=true
DB_MAX_OPEN_CONNS=180
DB_MAX_IDLE_CONNS=90
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m
SCHEDULER_DB_MAX_OPEN_CONNS=5
SCHEDULER_DB_MAX_IDLE_CONNS=2
MESSAGE_WORKER_DB_MAX_OPEN_CONNS=10
MESSAGE_WORKER_DB_MAX_IDLE_CONNS=5
REALTIME_DB_MAX_OPEN_CONNS=10
REALTIME_DB_MAX_IDLE_CONNS=5

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

JWT_SECRET=dev_jwt_secret_key_at_least_32_chars_long
JWT_EXP=86400
OTP_SECRET=dev_otp_secret_key
OTP_EXP=300
OTP_RATE_LIMIT_SECONDS=60

S3_ENDPOINT=http://s3mock:9090
S3_PRESIGN_ENDPOINT=http://localhost:9090
S3_PUBLIC_DOMAIN=http://localhost:9090/public-bucket
S3_REGION=us-east-1
S3_ACCESS_KEY=dummy
S3_SECRET_KEY=dummy
S3_BUCKET_PUBLIC=public-bucket
S3_BUCKET_PRIVATE=private-bucket
S3_FORCE_PATH_STYLE=true

SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@atoitalk.local
SMTP_FROM_NAME=AtoiTalk
SMTP_REQUIRE_TLS=false

GOOGLE_CLIENT_ID=dev_google_client_id
GOOGLE_CLIENT_SECRET=dev_google_client_secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback

TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

OTEL_ENABLED=true
OTEL_SERVICE_NAME=atoitalk-api
OTEL_SERVICE_VERSION=0.1.1
OTEL_EXPORTER_OTLP_ENDPOINT=signoz-otel-collector:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLING_RATIO=0.1
OTEL_METRIC_EXPORT_INTERVAL=5000
ENABLE_PPROF=true

REALTIME_PORT=8081
REALTIME_INSTANCE_ID=realtime-1
REALTIME_CONSUMER_GROUP=
MESSAGE_WORKER_BATCH_SIZE=100
MESSAGE_WORKER_CONCURRENCY=5
MESSAGE_WORKER_LEASE_DURATION=5m
MESSAGE_WORKER_POLL_INTERVAL=1s
MESSAGE_WORKER_BACKLOG_INTERVAL=5s
MESSAGE_EVENT_STREAM=events:messages
MESSAGE_EVENT_STREAM_MAX_LEN=10000
