APP_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=atoitalk
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=80
DB_MAX_IDLE_CONNS=40
DB_CONN_MAX_LIFETIME=30m
DB_CONN_MAX_IDLE_TIME=5m

S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
S3_PRESIGN_ENDPOINT=
S3_PUBLIC_DOMAIN=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_ASYNC=true

APP_PORT=8080
APP_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=*
RATE_LIMIT_ENABLED=true
CAPTCHA_ENABLED=true
REALTIME_PORT=8081
REALTIME_INSTANCE_ID=realtime-1
REALTIME_CONSUMER_GROUP=

DB_MIGRATE=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

JWT_SECRET=secret
JWT_EXP=86400
TURNSTILE_SECRET_KEY=

OTP_EXP=300
OTP_RATE_LIMIT_SECONDS=60
OTP_SECRET=secret

SOFT_DELETE_RETENTION_DAYS=30
MEDIA_RETENTION_DAYS=7

ENTITY_CLEANUP_CRON="0 2 * * *"
PRIVATE_CHAT_CLEANUP_CRON="30 2 * * *"
MEDIA_CLEANUP_CRON="0 3 * * *"

OTEL_ENABLED=false
OTEL_SERVICE_NAME=atoitalk-api
OTEL_SERVICE_VERSION=0.1.1
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SAMPLING_RATIO=0.1
OTEL_METRIC_EXPORT_INTERVAL=5000
ENABLE_PPROF=false

MESSAGE_WORKER_BATCH_SIZE=100
MESSAGE_WORKER_CONCURRENCY=5
MESSAGE_WORKER_LEASE_DURATION=5m
MESSAGE_WORKER_POLL_INTERVAL=1s
MESSAGE_WORKER_BACKLOG_INTERVAL=5s
MESSAGE_EVENT_STREAM=events:messages
MESSAGE_EVENT_STREAM_MAX_LEN=10000
